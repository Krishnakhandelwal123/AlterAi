{
  "rewrites": [
    {
      "source": "/((?!assets/|widget\\.js|embed-demo\\.html|_headers|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/chat/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *;"
        }
      ]
    }
  ]
}
